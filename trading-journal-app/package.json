{
  "name": "trading-journal-app",
  "version": "1.0.0",
  "description": "",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "concurrently \"npm:dev:renderer\" \"npm:dev:main\"",
    "dev:renderer": "cd renderer && npm run dev",
    "dev:main": "npm run build:main && electron dist/main/main.js",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "cd renderer && npm run build",
    "build:main": "tsc -p main/tsconfig.json && npm run copy:database",
    "copy:database": "if not exist dist\\main\\database mkdir dist\\main\\database && copy main\\database\\*.sql dist\\main\\database\\",
    "package": "electron-builder",
    "dist": "electron-builder --publish=never"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@rollup/rollup-win32-x64-msvc": "^4.42.0",
    "@types/better-sqlite3": "^7.6.13",
    "concurrently": "^9.1.2",
    "electron": "^36.4.0",
    "electron-builder": "^26.0.12",
    "electron-rebuild": "^3.2.9",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0"
  },
  "build": {
    "appId": "com.trading.journal",
    "productName": "Trading Journal",
    "directories": {
      "buildResources": "renderer/public",
      "output": "dist_electron"
    },
    "files": [
      "dist/main/**/*",
      "renderer/dist/**/*",
      "main/database/*.sql",
      "renderer/src/assets/AppIcon.ico"
    ],
    "extraResources": [
      {
        "from": "main/database/",
        "to": "database/",
        "filter": [
          "*.sql"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "renderer/src/assets/AppIcon.ico"
    }
  }
}